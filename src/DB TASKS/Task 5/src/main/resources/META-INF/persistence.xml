<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="lecture5-unit" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.student.lec5.entity.Student</class>
        <class>com.student.lec5.entity.Course</class>
        <class>com.student.lec5.entity.Doctor</class>
        <class>com.student.lec5.entity.Patient</class>
        <class>com.student.lec5.entity.Teacher</class>
        <class>com.student.lec5.entity.Language</class>
        <class>com.student.lec5.entity.Employee</class>
        <class>com.student.lec5.entity.Phone</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver"
                      value="oracle.jdbc.OracleDriver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:oracle:thin:@localhost:1521/XEPDB1"/>
            <property name="jakarta.persistence.jdbc.user"
                      value="YOUR_ORACLE_USERNAME"/>
            <property name="jakarta.persistence.jdbc.password"
                      value="YOUR_ORACLE_PASSWORD"/>

            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.OracleDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
